---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { projectImage } from '../lib/images';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(projects.length);
---

<dialog class="panel" data-project-dialog aria-labelledby="panel-title">
  <div class="panel-inner">
    <div class="panel-top">
      <span class="label" data-panel-position></span>
      <button type="button" class="close" data-close-project aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div class="panel-body" data-panel-body></div>

    <div class="panel-nav">
      <button type="button" class="mono" data-step="-1">← Previous</button>
      <button type="button" class="mono" data-step="1">Next →</button>
    </div>
  </div>
</dialog>

{
  projects.map(({ data: p }, i) => {
    const cover = projectImage(p.cover);
    const shots = p.screenshots.map((s) => ({ name: s, img: projectImage(s) }));
    return (
      <template data-project-template={p.slug} data-position={`Project ${pad(i + 1)} / ${total}`}>
        <div class="detail">
          <div class="intro">
            <h3 id="panel-title">{p.title}</h3>
            <p class="summary">{p.summary}</p>
          </div>

          <div class="shots">
            <div class="shot main">
              {cover ? (
                <Image src={cover} alt={`${p.title} screenshot`} widths={[560, 1120]} sizes="(min-width: 600px) 496px, 100vw" />
              ) : (
                <span class="mono placeholder">{p.cover}</span>
              )}
            </div>
            {shots.length > 0 && (
              <div class="shot-grid">
                {shots.map(({ name, img }, n) => (
                  <div class="shot">
                    {img ? (
                      <Image src={img} alt={`${p.title} screenshot ${n + 2}`} widths={[280, 560]} sizes="(min-width: 600px) 242px, 50vw" loading="lazy" />
                    ) : (
                      <span class="mono placeholder">{name}</span>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>

          <dl class="facts">
            <div>
              <dt class="label">Role</dt>
              <dd>{p.role}</dd>
            </div>
            <div>
              <dt class="label">Year</dt>
              <dd>{p.year}</dd>
            </div>
            <div>
              <dt class="label">Type</dt>
              <dd>{p.type}</dd>
            </div>
            <div>
              <dt class="label">Stack</dt>
              <dd>{p.stack.join(', ')}</dd>
            </div>
          </dl>

          <div class="actions">
            {p.demo_url && (
              <a class="btn primary" href={p.demo_url} target="_blank" rel="noopener">
                Live demo <span aria-hidden="true">↗</span>
              </a>
            )}
            {p.source_url && (
              <a class="btn" href={p.source_url} target="_blank" rel="noopener">
                Source code <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </template>
    );
  })
}

<style>
  .panel {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(560px, 100%);
    height: 100dvh;
    max-width: 100%;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
  }

  .panel::backdrop {
    background: var(--scrim);
  }

  .panel[open] {
    animation: slide-in var(--dur) var(--ease-out);
  }

  .panel[open]::backdrop {
    animation: fade-in 300ms var(--ease-out);
  }

  .panel.is-closing {
    animation: slide-out 280ms var(--ease-out) forwards;
  }

  .panel.is-closing::backdrop {
    animation: fade-out 280ms var(--ease-out) forwards;
  }

  @keyframes slide-in {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
  }

  @keyframes slide-out {
    to {
      transform: translateX(40px);
      opacity: 0;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  .panel-inner {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 28px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .panel-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .close {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    transition:
      transform 300ms var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .close:hover {
    transform: rotate(90deg);
    border-color: var(--muted);
  }

  .panel-body {
    flex: 1;
  }

  /* Konten berganti saat Previous / Next */
  .panel-body :global(.detail) {
    animation: swap 400ms var(--ease-out);
  }

  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .panel-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .panel-nav button {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 13px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .panel-nav button:hover {
    color: var(--fg);
  }

  /* Isi detail (dari <template>) */
  :global(.detail) {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  :global(.detail .intro) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  :global(.detail h3) {
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 600;
  }

  :global(.detail .summary) {
    font-size: 1.0625rem;
    color: var(--muted);
  }

  :global(.detail .shots) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  :global(.detail .shot-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  :global(.detail .shot) {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
  }

  :global(.detail .shot.main) {
    aspect-ratio: 16 / 10;
  }

  :global(.detail .shot img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.detail .placeholder) {
    font-size: 12px;
    color: var(--muted);
    padding: 16px;
    text-align: center;
  }

  :global(.detail .facts) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
    padding: 24px 0;
    border-block: 1px solid var(--line);
  }

  :global(.detail .facts div) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.detail .facts .label) {
    font-size: 11px;
  }

  :global(.detail .facts dd) {
    font-size: 15px;
  }

  :global(.detail .actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  :global(.detail .btn) {
    min-height: 48px;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  :global(.detail .btn:hover) {
    border-color: var(--muted);
  }

  :global(.detail .btn.primary) {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  :global(.detail .btn:active) {
    transform: scale(0.97);
  }

  :global(.detail .btn span) {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  :global(.detail .btn:hover span) {
    transform: translate(2px, -2px);
  }

  @media (max-width: 600px) {
    .panel-inner {
      padding: 20px 20px 24px;
    }
  }
</style>

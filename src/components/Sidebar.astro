---
import { site } from '../data/site';

const nav = [
  { id: 'projects', label: 'Projects' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];
const year = new Date().getFullYear();
---

<aside class="sidebar">
  <div class="top">
    <span class="label">Portfolio — {year}</span>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light and dark mode">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
      </svg>
    </button>
  </div>

  <div class="intro">
    <h1 class="name">
      {site.name.split(' ').map((word) => <span>{word}</span>)}
    </h1>
    <p class="role">{site.role}</p>
    <p class="tagline">{site.tagline}</p>
    {
      site.status && (
        <p class="status mono">
          <span class="dot" aria-hidden="true" />
          {site.status}
        </p>
      )
    }
  </div>

  <nav aria-label="Sections">
    <ul class="nav">
      {
        nav.map((item, i) => (
          <li>
            <a href={`#${item.id}`} data-nav={item.id}>
              <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ul class="links mono">
    {
      site.links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener">
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Sticky di desktop: ikut terlihat saat konten di kanan di-scroll */
  @media (min-width: 960px) {
    .sidebar {
      position: sticky;
      top: 56px;
      max-height: calc(100vh - 112px);
      overflow-y: auto;
      scrollbar-width: none;
    }
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .theme-toggle {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    border-color: var(--muted);
  }

  .theme-toggle:active {
    transform: scale(0.94);
  }

  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      opacity 250ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .name {
    font-size: clamp(3rem, 2.2rem + 3vw, 4.25rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 600;
  }

  .name span {
    display: block;
  }

  .role {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .tagline {
    color: var(--muted);
    line-height: 1.55;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    animation: pulse 2.4s var(--ease-out) infinite;
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  .nav {
    border-top: 1px solid var(--line);
  }

  .nav a {
    position: relative;
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    transition: padding-left 300ms var(--ease-out);
  }

  /* Indikator section aktif */
  .nav a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 8px;
    height: 2px;
    background: var(--accent);
    transform: translateY(-50%) scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease-out);
  }

  .nav a[aria-current='true'] {
    padding-left: 18px;
  }

  .nav a[aria-current='true']::before {
    transform: translateY(-50%) scaleX(1);
  }

  .nav a:hover {
    padding-left: 18px;
  }

  .num {
    font-size: 12px;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    font-size: 13px;
    color: var(--muted);
  }

  .links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .links a:hover {
    color: var(--fg);
  }

  .links a span {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .links a:hover span {
    transform: translate(2px, -2px);
  }
</style>
